# Copy this file to .env and fill in the values before starting the stack.
# .env is gitignored — never commit it.

# PostgreSQL password for predictor_user
# Generate a strong one: openssl rand -base64 32
POSTGRES_PASSWORD=change_me_to_a_strong_password

# Secret used to sign JWT tokens — must be long and random
# Generate one: openssl rand -base64 48
AUTH_SECRET=change_me_to_a_long_random_secret

# API key for the football data provider
FOOTBALL_API_KEY=your_football_api_key_here

# Set to "production" on the VPS
NODE_ENV=production
