# PostgreSQL database configuration
DATABASE_URL=postgresql://predictor_user:predictor_password@db:5432/world_cup_2026

# Backend server port
BACKEND_PORT=3001

# Football Data API
FOOTBALL_API_KEY=your_football_data_api_key_here

# Secret used to sign JWT tokens — change this to a long random string in production
# Generate one with: openssl rand -hex 32
AUTH_SECRET=your_secret_key_here_change_in_production

# Environment
NODE_ENV=development
